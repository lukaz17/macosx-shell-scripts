#!/bin/sh

################################################################################
#
#  firefox-install
#
#  Install/Update Mozilla Firefox for current user. This also works as a version manager.
#
#  Homepage: https://www.firefox.com/
#
#  Usage:
#    firefox-install <version>
#
#  Example:
#    firefox-install 147.0.4
#    firefox-install v147.0.4
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -e

# Application info
PROGRAM_ID="firefox"
PROGRAM_EXEC="Firefox.app"

# Shared library
CTXDIR="$(cd "$(dirname "${0}")" && pwd)"
. "${CTXDIR}/shared/install-common.sh"
. "${CTXDIR}/shared/install-source.sh"

# Prepare environment
get_install_argument "$@"
normalize_install_version "${INSTALL_ARG_VERSION}"
init_install_env_desktop "${PROGRAM_ID}" "${INSTALL_VERSION}"

# Download and install binaries
if [ ! -d "${INSTALL_TARGET}" ]; then
	BIN_ARCH_URI_AMD64="$(get_download_uri_amd64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	BIN_ARCH_URI_ARM64="$(get_download_uri_arm64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	BIN_ARCH_TMP_FILE="${TEMP_TARGET}.dmg"
	download_uri_per_arch "${BIN_ARCH_URI_AMD64}" "${BIN_ARCH_URI_ARM64}" "${BIN_ARCH_TMP_FILE}"
	create_dir "${TEMP_TARGET}"
	extract_archive "${BIN_ARCH_TMP_FILE}" "dmg" "${TEMP_TARGET}"
	remove_item "${BIN_ARCH_TMP_FILE}"
	move_item "${TEMP_TARGET}" "${INSTALL_TARGET}"
	remove_item "${TEMP_TARGET}"
fi

# Finalize install
copy_item_overwrite "${INSTALL_TARGET}" "${ACTIVE_TARGET}"
symlink_item_overwrite "${ACTIVE_TARGET}/${PROGRAM_EXEC}" "${DESKTOP_ROOT}/${PROGRAM_EXEC}"
finalize_install
